        <!-- Cloud Run Internals: Backend -->
        <mxCell id="backend_box" value="&lt;b&gt;Backend REST API (FastAPI 0.115)&lt;/b&gt;&lt;br/&gt;• Python 3.11 Runtime assíncrono (Uvicorn)&lt;br/&gt;• &lt;code&gt;/api/v1/distribuicao/*&lt;/code&gt; (DEC/FEC real vs limites)&lt;br/&gt;• &lt;code&gt;/api/v1/tarifas/*&lt;/code&gt; (Rankings TE/TUSD)&lt;br/&gt;• &lt;code&gt;/api/v1/simulador/*&lt;/code&gt; (Fórmula Revisão Tarifária)&lt;br/&gt;• &lt;code&gt;/api/v1/ingestion/datalake/status&lt;/code&gt; (Health Monitor)&lt;br/&gt;• &lt;code&gt;/api/v1/ingestion/datalake/run&lt;/code&gt; (Master Trigger)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="265" width="300" height="120" as="geometry"/>
        </mxCell>

        <!-- Cloud Run Internals: Frontend SPA -->
        <mxCell id="frontend_box" value="&lt;b&gt;Frontend Single Page Application (SPA)&lt;/b&gt;&lt;br/&gt;• React 18 + TypeScript + Vite + TailwindCSS&lt;br/&gt;• Biblioteca de Gráficos: Recharts &amp; Lucide Icons&lt;br/&gt;• Cockpit C-Level: DEC/FEC, MMGD, Tarifas, IASC&lt;br/&gt;• Filtros Reativos por UF, Concessionária e Tensão&lt;br/&gt;• Simulador Interativo de Faturas &amp; Economia GD&lt;br/&gt;• Servido estaticamente em &lt;code&gt;/app/static&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="395" width="300" height="115" as="geometry"/>
        </mxCell>

        <!-- Cloud Run Specs -->
        <mxCell id="cloudrun_specs" value="Configurações do Container:&#xa;• CPU: 1 vCPU | Memória: 1 GiB | Timeout: 300s&#xa;• Concorrência: 80 requisições simultâneas&#xa;• Auto-scaling: 0 a N instâncias (Scale to Zero)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#A5B4FC;fontColor=#3730A3;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
