        <!-- FinOps Summary Box -->
        <mxCell id="finops_box" value="&lt;b&gt;💰 Resumo FinOps (Otimização de Custos)&lt;/b&gt;&lt;br/&gt;• Cloud Run: &lt;i&gt;R$ 0,00&lt;/i&gt; (dentro do free tier de 2M req/mês)&#xa;• Cloud Scheduler: &lt;i&gt;R$ 0,00&lt;/i&gt; (3 jobs grátis + $0.10/job)&#xa;• BigQuery Storage: &lt;i&gt;Centavos/mês&lt;/i&gt; (&lt; 1 GB total)&#xa;• BigQuery BI Engine: Aceleração in-memory de alta eficiência&#xa;&lt;b&gt;Custo Total da Infraestrutura: ~R$ 0,00 a R$ 5,00 / mês&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#FACC15;fontColor=#713F12;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1505" y="700" width="370" height="100" as="geometry"/>
