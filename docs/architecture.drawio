        <mxCell id="job1" value="&lt;b&gt;aneel-datalake-master-diario&lt;/b&gt;&lt;br/&gt;• Cron: &lt;code&gt;0 23 * * *&lt;/code&gt; (23:00 BRT Diário)&lt;br/&gt;• Endpoint: &lt;code&gt;/api/v1/ingestion/datalake/run&lt;/code&gt;&lt;br/&gt;• Executa: Ingestão 4 domínios ➔ Gold ➔ Quality" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
