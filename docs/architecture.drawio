              <mxPoint x="700" y="105"/>
              <mxPoint x="1105" y="105"/>
              <mxPoint x="1105" y="325"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 3. Ingestor -> Bronze GCS -->
        <mxCell id="flow_ingest_to_bronze" value="Upload Parquet/CSV" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#D97706;strokeWidth=2;" edge="1" parent="1" source="ingestor_engine" target="bronze_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 4. Bronze GCS -> Silver BigQuery -->
        <mxCell id="flow_bronze_to_silver" value="Limpeza, Tipagem &amp; MERGE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="1" source="bronze_box" target="silver_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 5. Silver BigQuery -> Dataform -->
        <mxCell id="flow_silver_to_dataform" value="Transformação SQLX" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#EF4444;strokeWidth=2;" edge="1" parent="1" source="silver_box" target="dataform_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 6. Dataform -> Gold BigQuery -->
        <mxCell id="flow_dataform_to_gold" value="Tabelas Analíticas de KPIs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#EAB308;strokeWidth=2;" edge="1" parent="1" source="dataform_box" target="gold_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 7. Gold BigQuery (BI Engine) -> Cloud Run Backend -->
        <mxCell id="flow_gold_to_backend" value="SQL Sub-segundo via BI Engine" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;strokeColor=#2563EB;strokeWidth=3;" edge="1" parent="1" source="gold_box" target="backend_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 8. Cloud Run Backend -> Frontend SPA -->
        <mxCell id="flow_backend_to_frontend" value="JSON REST API &amp; WebSocket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#6366F1;strokeWidth=2;" edge="1" parent="1" source="backend_box" target="frontend_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 9. Cloud Run -> Clientes / Stakeholders -->
        <mxCell id="flow_cloudrun_to_clients" value="HTTPS (TLS 1.3) / Web Dashboard" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#0F766E;strokeWidth=3;" edge="1" parent="1" source="frontend_box" target="client_channels">
          <mxGeometry relative="1" as="geometry"/>
