        <!-- 10. Composer -> Ingestion (Alternativa Tracejada) -->
        <mxCell id="flow_composer_to_ingest" value="PythonOperator" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#9333EA;strokeWidth=1;strokeDashed=1;" edge="1" parent="1" source="composer_container" target="ingestor_engine">
