        <!-- Fontes ANEEL -->
        <mxCell id="src_aneel_prodist" value="&lt;b&gt;ANEEL: PRODIST Módulo 8&lt;/b&gt;&lt;br/&gt;• DEC e FEC de Distribuição&lt;br/&gt;• Limites Regulatórios Anuais&lt;br/&gt;• Compensações Financeiras (R$)&lt;br/&gt;&lt;i&gt;Formato: Parquet Oficial (28.8 MB)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
