        <mxCell id="flow_src_to_ingest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="src_aneel_prodist" target="ingestor_engine">
          <mxGeometry relative="1" as="geometry"/>
