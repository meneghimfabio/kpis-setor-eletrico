        <!-- Stakeholders & Perfis de Consumo -->
        <mxCell id="user_profiles" value="&lt;b&gt;Perfis de Stakeholders &amp; Consumidores&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;👔 &lt;b&gt;Diretoria Executiva / C-Level:&lt;/b&gt;&lt;br/&gt;• Cockpit executivo DEC/FEC e risco de multas regulatórias&lt;br/&gt;• Ranking tarifário residencial B1 e corporativo A4&lt;br/&gt;&lt;br/&gt;⚡ &lt;b&gt;Engenharia de Operação &amp; Distribuição:&lt;/b&gt;&lt;br/&gt;• Monitoramento de metas contratuais e perdas de energia&lt;br/&gt;• Acompanhamento da expansão da GD Solar (Lei 14.300)&lt;br/&gt;&lt;br/&gt;💼 &lt;b&gt;Gestores Comerciais / Mercado Livre:&lt;/b&gt;&lt;br/&gt;• Simulação de migração Cativo ➔ Livre (ACL)&lt;br/&gt;• Índices de reclamação e satisfação IASC por distribuidora" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#5EEAD4;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1505" y="195" width="370" height="235" as="geometry"/>
