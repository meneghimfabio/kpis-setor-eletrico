        </mxCell>
        <mxCell id="src_aneel_mmgd" value="&lt;b&gt;ANEEL: SISGD (Lei 14.300)&lt;/b&gt;&lt;br/&gt;• Micro e Minigeração Distribuída&lt;br/&gt;• Potência Instalada (kW/MW)&lt;br/&gt;• Fonte Solar Fotovoltaica / UFs&lt;br/&gt;&lt;i&gt;Formato: Parquet Oficial (100.7 MB)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="305" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="src_aneel_tarifas" value="&lt;b&gt;ANEEL: PRORET (Tarifas)&lt;/b&gt;&lt;br/&gt;• Tarifas Homologadas TE e TUSD&lt;br/&gt;• Classes B1 (Residencial), B3, A4&lt;br/&gt;• 103 Distribuidoras Concessionárias&lt;br/&gt;&lt;i&gt;Formato: CSV Oficial (84.9 MB)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="415" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="src_aneel_ouvidoria" value="&lt;b&gt;ANEEL: Ouvidoria &amp; IASC&lt;/b&gt;&lt;br/&gt;• Reclamações de Nível 2 / Prazos&lt;br/&gt;• Índice de Satisfação do Consumidor&lt;br/&gt;• Prêmios de Qualidade IASC&lt;br/&gt;&lt;i&gt;Formato: Parquet &amp; CSV (28.6 MB)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
