# ==============================================================================
# Variáveis de Ambiente - KPIs do Setor Elétrico Brasileiro
# ==============================================================================

# Configurações do Google Cloud Platform (GCP)
GCP_PROJECT_ID=kpisetoreletrico
GCP_REGION=us-central1
GCS_BRONZE_BUCKET=kpisetoreletrico-datalake-bronze
BIGQUERY_SILVER_DATASET=aneel_silver
BIGQUERY_GOLD_DATASET=gold_kpis

# Autenticação GCP (Opcional se utilizando gcloud auth application-default login)
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account.json

# Servidor Backend FastAPI
HOST=0.0.0.0
PORT=8000
RELOAD=true
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Vite
VITE_API_URL=http://localhost:8000
