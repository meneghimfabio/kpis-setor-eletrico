config {
  type: "table",
  schema: "gold_kpis",
  name: "kpi_ccee_mercado_resumo",
  description: "Visão executiva e analítica consolidada do Mercado CCEE: PLD médio, spreads regionais, risco hidrológico (GSF), ESS e restrições de curtailment.",
  tags: ["gold", "ccee", "bi_engine"]
}

WITH latest_pld AS (
  SELECT
    data_hora,
    subsistema,
    pld_rs_mwh,
    pld_teto_rs_mwh,
    pld_piso_rs_mwh,
    patamar,
    ROW_NUMBER() OVER (PARTITION BY subsistema ORDER BY data_hora DESC) as rn
  FROM
    `${ref("mercado_ccee", "pld_horario")}`
),
pld_filtrado AS (
  SELECT
    subsistema,
    pld_rs_mwh,
    pld_teto_rs_mwh,
    pld_piso_rs_mwh,
    patamar,
    data_hora as data_apuracao
  FROM
    latest_pld
  WHERE
    rn = 1
),
pld_stats AS (
  SELECT
    ROUND(AVG(pld_rs_mwh), 2) as pld_medio_nacional_rs_mwh,
    ROUND(MAX(pld_rs_mwh) - MIN(pld_rs_mwh), 2) as spread_maximo_regional_rs_mwh,
    CASE 
      WHEN (MAX(pld_rs_mwh) - MIN(pld_rs_mwh)) > 15.0 THEN "Alerta: Descolamento Estrutural entre Submercados"
      ELSE "Equilíbrio Inter-regional"
    END as status_integracao_sin
  FROM
    pld_filtrado
)
SELECT
  p.subsistema,
  p.pld_rs_mwh,
  p.pld_teto_rs_mwh,
  p.pld_piso_rs_mwh,
  p.patamar,
  p.data_apuracao,
  s.pld_medio_nacional_rs_mwh,
  s.spread_maximo_regional_rs_mwh,
  s.status_integracao_sin,
  ROUND((p.pld_rs_mwh - s.pld_medio_nacional_rs_mwh), 2) as diferenca_vs_media_nacional
FROM
  pld_filtrado p
CROSS JOIN
  pld_stats s
ORDER BY
  p.pld_rs_mwh DESC
